#version 460
#extension GL_EXT_mesh_shader : require

struct Meshlet
{
	uint vertexOffset;
	uint triangleOffset;
	uint vertexCount;
	uint triangleCount;
};
struct CullingInfo
{
	//normal cone, useful for backface culling
	vec3 coneApex;
	float coneCutoff; // = cos(angle/2)
	vec3 coneAxis;
};
layout(std430, binding = 8) readonly buffer MeshletCounts { uint modelMeshletCount[]; };
layout(std430, binding = 7) readonly buffer CullInfoBuffer { CullingInfo meshletCullInfos[]; };
layout(std430, binding = 6) readonly buffer ModelIDs { uint modelIDs[]; };
layout(std430, binding = 5) readonly buffer Transforms 
{
	mat4 models[];
};
layout(std140, binding = 4) uniform transformations
{
	mat4 viewProj;
    vec3 cameraPos;
};
struct TaskInfo
{
	uint meshID;
	uint meshletID[gl_WorkGroupSize.x];
};
taskPayloadSharedEXT TaskInfo meshletIn;
shared uint numMeshlets;

layout(local_size_x_id = 1) in;
layout(local_size_y = 1, local_size_z = 1) in;
void main()
{
	if (gl_GlobalInvocationID.x < modelMeshletCount[gl_DrawID])
	{
		if (gl_LocalInvocationID.x == 0)
		{
			numMeshlets = 0;
			meshletIn.meshID = modelIDs[gl_DrawID];
		}
		barrier();
		//memoryBarrier();
		memoryBarrierShared();
		//CullingInfo cInfo = meshletCullInfos[gl_GlobalInvocationID.x];
		//if (gl_GlobalInvocationID.x == 1 || gl_GlobalInvocationID.x == 6 || gl_GlobalInvocationID.x == 0 || gl_GlobalInvocationID.x == 16)
		//if (dot(normalize(cInfo.coneApex - cameraPos), cInfo.coneAxis) < cInfo.coneCutoff)
		//if (dot(normalize((models[gl_DrawID] * vec4(cInfo.coneApex, 1.0f)).xyz - cameraPos), (models[gl_DrawID] * vec4(cInfo.coneAxis, 1.0f)).xyz) >= cInfo.coneCutoff)
		{
			const uint currMeshletIdx = atomicAdd(numMeshlets, 1);
			meshletIn.meshletID[currMeshletIdx] = gl_GlobalInvocationID.x;
		}
		barrier();
		EmitMeshTasksEXT(numMeshlets, 1, 1);
	}
}






